# OneBot v11 连接（SnowLuma / NapCat / Lagrange 等）
ONEBOT_HTTP=http://127.0.0.1:3000
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=填写OneBot的HTTP访问Token
# 注意：WebSocket 的 token 常常与 HTTP 不同，留空则回退用 ONEBOT_TOKEN
ONEBOT_WS_TOKEN=

# ===== 自带模型 =====
# bot 自己持有模型凭据，独立于任何外部 Agent 宿主。
# 留空 LLM_API_KEY 则只提供 MCP 工具，不主动发言。
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
# 思考链：disabled 省 token/时间；enabled 更聪明但更慢更贵
LLM_THINKING=disabled
# 仅当 LLM_THINKING=enabled 时有效：low / high / max
LLM_REASONING_EFFORT=
LLM_TIMEOUT=60
LLM_TEMPERATURE=1.0
# system prompt：指向一个 markdown 文件，改完热加载
SYSTEM_PROMPT_FILE=data/system_prompt.md
# false = bot 只做工具，不接话
AUTO_REPLY=true

# ===== 内置 Agent =====
# 让 bot 自己读写文件、执行命令，替代外部 Agent 宿主。
# 每一次读取与写入都会逐行记录到 data/agent.log，并写入审计表。
AGENT_ENABLED=true
# 文件操作的根目录；越界一律拒绝。留空 = qqbridge 仓库根目录。
AGENT_ROOT=
AGENT_MAX_STEPS=60

# 本服务监听
MCP_HOST=127.0.0.1
MCP_PORT=18900
MCP_PATH=/mcp
# MCP 与控制台共用的访问令牌，务必改掉
MCP_TOKEN=change-me

# 安全：只有这些 QQ 号能触发写操作（逗号分隔）。留空则拒绝所有写操作。
OWNER_IDS=
# 写操作总开关
ALLOW_SEND=false
ALLOW_MANAGE=false

# 只监控这些群（逗号分隔）；留空=全部群。
# 范围外的群只落库，绝不入队、不唤醒模型。
WATCH_GROUPS=

# 事件总线
RING_SIZE=500
# 自动触发接话的冷却秒数（0=不自动触发）
COOLDOWN_SECONDS=90
# 管理员：可在群里执行 /stop /start /auto 控制机器人运行。留空则退回 OWNER_IDS
ADMIN_IDS=